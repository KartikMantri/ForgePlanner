# Forge Frontend — Local Development Environment
# Copy this file to .env and fill in your values.

# Backend API base URL
VITE_API_URL=http://localhost:8000/api/v1

# ── Supabase Auth ──────────────────────────────────────────────────────────────
# Same project as the backend. Use the publishable/anon key here — never the
# service role key, this ships to the browser.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# ── 3D scenes (Spline) ─────────────────────────────────────────────────────────
# Public .splinecode export URLs from https://spline.design
# Leave empty to keep the current CSS/SVG visuals — nothing breaks either way.
VITE_SPLINE_IRONMAN_SCENE=
VITE_SPLINE_SPIDERMAN_SCENE=
