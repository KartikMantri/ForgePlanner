# Forge Frontend — Local Development Environment
# Copy this file to .env and fill in your values.

# Backend API base URL
VITE_API_URL=http://localhost:8000/api/v1

# ── 3D scenes (Spline) ─────────────────────────────────────────────────────────
# Public .splinecode export URLs from https://spline.design
# Leave empty to keep the current CSS/SVG visuals — nothing breaks either way.
VITE_SPLINE_IRONMAN_SCENE=
VITE_SPLINE_SPIDERMAN_SCENE=
