# =============================================================================
# Forge Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Frontend (for CORS) ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins (dev + production), e.g.:
# FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── AI — Gemini (Primary) ─────────────────────────────────────────────────────
# Free tier: 1,500 requests/day, 1M tokens/min
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# ── AI — Groq (Fallback) ──────────────────────────────────────────────────────
# Free tier: 14,400 requests/day on llama-3.3-70b
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=paste-your-groq-key-here
